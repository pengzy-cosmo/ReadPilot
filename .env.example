# OpenAI API Key (Required)
OPENAI_API_KEY=sk-your-key-here

# Optional: Custom Base URL (e.g. for LocalAI, Ollama, or Azure)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: Allowed Origins for CORS (default: http://localhost:5173)
# READPILOT_ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com
