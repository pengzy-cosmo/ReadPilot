		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"katex": "^0.16.27",
		"lucide-react": "^0.562.0",
		"pdfjs-dist": "5.4.296",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-markdown": "^10.1.0",
		"react-pdf": "^10.2.0",
		"react-resizable-panels": "^4.3.1",
		"react-virtuoso": "^4.6.2",
		"rehype-katex": "^7.0.1",
		"remark-gfm": "^4.0.1",
		"remark-math": "^6.0.0",
